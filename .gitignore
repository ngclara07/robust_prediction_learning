# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Raw / processed datasets
data/raw/*
data/processed/*

# Keep directories if desired
!data/raw/.gitkeep
!data/processed/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python package build metadata
src/*.egg-info/
*.egg-info/

# Added the LaTex temporary files 
@"

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
"@ | Add-Content .gitignore
